# Where smallcloud keeps everything (platform db, app bundles, app data). Back this dir up.
SC_DATA_DIR=./data
# Public URL people will open. Used in magic links and share links.
SC_BASE_URL=http://localhost:8787
PORT=8787
# Long random string. Signs sessions and encrypts app secrets. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SC_SECRET=change-me
# Magic-link email via Resend (https://resend.com). Leave unset and links print to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=smallcloud <login@yourdomain.com>
# Comma-separated emails allowed to sign in. Unset = anyone with an email can sign in (they still only see what is shared with them).
SC_ALLOWED_EMAILS=
